@model ServiFlow.Models.Emprendimiento
<link rel="stylesheet" href="~/css/Create.css" asp-append-version="true" />

<div class="registro-container">

    <!-- FORMULARIO -->
    <div class="registro-form">
<h2 class="empren">Crear Emprendimiento</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div>      
        <input asp-for="Nombre" class="input-custom" placeholder="Nombre" />
    </div>

    <div>
        
        <input asp-for="TipoServicio" class="input-custom" placeholder="Tipo de Emprendimiento" />
    </div>

    <div>
       
        <input asp-for="Descripcion" class="input-custom" placeholder="Descripción" />
    </div>
   

    <button type="submit">Guardar</button>
            <div>
                <a asp-controller="Emprendimientos" class="botonVolver btnEmp"
                   asp-action="InicioEmprendedor">
                    ← Volver a Portafolio de Servicios
                </a>
            </div>
    
</form>
    </div>

    <!-- IMAGEN -->
    <div class="registro-img crearImg">
        <img src="~/images/crear.png" alt="Registro ServiFlow" class="img-crear">
    </div>
    

</div>

<script>
function previewImagen(event) {
  const file = event.target.files[0];
  const preview = document.getElementById("preview");
  const texto = document.getElementById("textoFile");

  if (file) {
    preview.src = URL.createObjectURL(file);
    preview.style.display = "block";

    texto.textContent = file.name;
  }
}
</script>