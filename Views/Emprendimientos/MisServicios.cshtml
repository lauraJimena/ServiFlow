@model IEnumerable<ServiFlow.Models.Emprendimiento>
@using System.Linq

@{
    ViewData["Title"] = "Mis Servicios";
}

@section Styles {
    <link rel="stylesheet" href="~/css/MisServicios.css" asp-append-version="true" />
}

<section class="ms-page">
    <div class="ms-container">

        <div class="ms-header">
            <div>
                <h1>Mis Emprendimientos</h1>
                <p>Gestiona los emprendimientos y servicios publicados en ServiFlow.</p>
            </div>

            <a asp-action="Create" class="ms-btn-crear">
                + Crear nuevo
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="ms-table-wrap">
                <table class="ms-table">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>Descripción</th>
                            <th class="ms-actions-col">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ms-name">@item.Nombre</td>

                                <td>
                                    <span class="ms-badge">@item.TipoServicio</span>
                                </td>

                                <td class="ms-description">
                                    @item.Descripcion
                                </td>

                                <td class="ms-actions">
                                    <a asp-controller="Kanban"
                                       asp-action="Index"
                                       asp-route-emprendimientoId="@item.Id"
                                       class="ms-btn ms-btn-soft">
                                        Abrir Kanban
                                    </a>
                                 
                                    <a asp-controller="Estadisticas"
                                       asp-action="Index"
                                       asp-route-emprendimientoId="@item.Id"
                                       class="ms-btn ms-btn-soft">                                        
                                        Ver estadísticas
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="ms-btn ms-btn-soft">
                                        Editar
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="ms-inline-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="ms-btn ms-btn-danger"
                                                onclick="return confirm('¿Seguro que deseas eliminar este emprendimiento?');">
                                            Eliminar
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ms-empty">
                <h3>No tienes servicios registrados</h3>
                <p>Empieza creando tu primer emprendimiento o servicio.</p>
                <a asp-action="Create" class="ms-btn-crear">Crear nuevo</a>
            </div>
        }
    </div>
    <div>
        <a asp-controller="Emprendimientos" class="botonVolver"
           asp-action="InicioEmprendedor">
            ← Volver a Portafolio de Servicios
        </a>
    </div>
</section>

@if (TempData["Mensaje"] != null)
{
    <div class="ms-overlay" id="modalExito">
        <div class="ms-modal">
            <h3>Éxito</h3>
            <p>@TempData["Mensaje"]</p>
            <button type="button" onclick="cerrarModal()">Cerrar</button>
        </div>
    </div>
}

@section Scripts {
    <script>
        function cerrarModal() {
            const modal = document.getElementById('modalExito');
            if (modal) {
                modal.style.display = 'none';
            }
        }
    </script>
}