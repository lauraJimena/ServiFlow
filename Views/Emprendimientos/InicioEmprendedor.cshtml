@model IEnumerable<Emprendimiento>

<link rel="stylesheet" href="~/css/IndexGeneral.css" asp-append-version="true" />
<section class="page-container">
<section class="hero">
    <div class="hero-header">
            <div class="hero-text">
                <h1>Portafolio de mis Emprendimientos</h1>

                @if (Model != null && Model.Any())
                {
                    <p class="hero-subtitle">
                        A continuación se muestran los emprendimientos que tienes registrados en ServiFlow
                    </p>
                }
                else
                {
                    <p class="hero-subtitle">
                        Aún no tienes emprendimientos registrados
                    </p>

                    <!-- Modal invitación -->
                    <div class="modal fade" id="crearEmprendimientoModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content fondo-tarjetas">
                                <div class="modal-header">
                                    <h5 class="modal-title">¡Bienvenido a ServiFlow!</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                </div>
                                <div class="modal-body text-center">
                                    <p>Empieza creando tu primer emprendimiento para gestionar tus servicios.</p>
                                    <a class="btn btn-primary"
                                       asp-controller="Emprendimientos"
                                       asp-action="Create">
                                        Crear emprendimiento
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <script>
                        document.addEventListener("DOMContentLoaded", function () {
                            var modal = new bootstrap.Modal(document.getElementById('crearEmprendimientoModal'));
                            modal.show();
                        });
                    </script>
                }
            </div>


        <div class="acciones-header">
            <a class="btn-crear-main"
               asp-controller="Emprendimientos"
               asp-action="Create">
                <img src="~/images/plus.png" alt="Crear" class="icono-img">
                
                Crear emprendimiento
            </a>

            <a class="btn-admin"
               asp-controller="Emprendimientos"
               asp-action="MisServicios">
               <img src="~/images/gear (2).png" alt="Administrar" class="icono-img">
                Administrar servicios
            </a>
        </div>
    </div>
</section>

<section class="grid-servicios">
    @foreach (var e in Model)
    {
        <article class="card-servicio">
                <a asp-controller="Emprendimientos"
                   asp-action="Edit"
                   asp-route-id="@e.Id"
                   class="card-img-link">
                    <img class="card-img" src="@e.ImagenUrl" alt="@e.Nombre" />
                </a>
            

            <div class="card-overlay"></div>

            <div class="card-content">
                <h3 class="card-title">@e.Nombre</h3>
                <span class="card-sub">@e.TipoServicio</span>
               

                <div class="card-buttons">


                    <div class="card-buttons">

                        <div class="card-buttons">
                            

                            <a class="btn-card btn-disponibilidad"
                               asp-controller="Disponibilidades"
                               asp-action="Index"
                               asp-route-emprendimientoId="@e.Id">
                                Disponibilidad
                            </a>
                            <a class="btn-card btn-citas"
                               asp-controller="Citas"
                               asp-action="CitasEmprendimiento"
                               asp-route-emprendimientoId="@e.Id">
                                Ver citas
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </article>
    }
</section>


</section>

@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

@if (totalPages > 1)
{
    <nav class="pagination-wrap">
        @if (currentPage > 1)
        {
            <a class="page-link"
            asp-controller="Emprendimientos"
               asp-action="InicioEmprendedor"
               asp-route-page="@(currentPage - 1)">Anterior</a>
        }
        else
        {
            <span class="page-disabled">Anterior</span>
        }

        @for (int i = 1; i <= totalPages; i++)
        {
            <a class="page-number @(i == currentPage ? "active" : "")"
               asp-controller="Emprendimientos"
               asp-action="InicioEmprendedor"
               asp-route-page="@i">
                @i
            </a>
        }

        @if (currentPage < totalPages)
        {
            <a class="page-link"
               asp-controller="Emprendimientos"
               asp-action="InicioEmprendedor"
            asp-route-page="@(currentPage + 1)">Siguiente</a>
        }
        else
        {
            <span class="page-disabled">Siguiente</span>
        }
    </nav>
}