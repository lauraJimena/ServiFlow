<link rel="stylesheet" href="~/css/Planes.css" asp-append-version="true" />

<section class="planes-hero">
    <div class="planes-container">
        <h1>Planes de ServiFlow</h1>
        <p>Elige cómo quieres organizar tu talento</p>
    </div>
</section>

<section class="planes-grid">
    <div class="plan-card basic">

        <h2>Plan Básico</h2>
        <p class="precio">Gratis</p>

        <ul>
            <li>✔ 1 emprendimiento</li>
            <li>✔ Hasta 3 servicios</li>
            <li>✔ Agenda básica(gestiona tus horarios manualmente)</li>
            <li class="disabled">✖ Notificaciones por medio de WhatsApp</li>
            <li class="disabled">✖ Historial de citas completo</li>
            <li class="disabled">✖ Estadísticas por emprendimiento</li>
            <li class="disabled">✖ Kanban</li>
        </ul>

        <button class="btn-plan">Plan actual</button>
    </div>

    <div class="plan-card pro">

        <h2>Plan Pro</h2>
        <p class="precio">$29.900 / mes</p>

        <ul>
            <li>✔ Emprendimientos ilimitados</li>
            <li>✔ Servicios ilimitados</li>
            <li>✔ Agenda completa(publica múltiples horarios en segundos)</li>
            <li>✔ Historial de citas de citas completo</li>
            <li>✔ Estadísticas por emprendimiento</li>
            <li>✔ Notificaciones de tus citas por medio de WhatsApp</li>
            <li>✔ Tablero Kanban para la organizacion de tus tareas internas</li>
        </ul>

        <button class="btn-plan destacado">Elegir plan</button>
    </div>
</section>