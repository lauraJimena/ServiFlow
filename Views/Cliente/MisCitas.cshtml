@model ServiFlow.ViewModels.MisCitasClienteVM

@{
    Layout = "_LayoutCliente";
    ViewData["Title"] = "Mis citas";
}

<link rel="stylesheet" href="~/css/MisCitas.css" asp-append-version="true" />

<div class="citas-page">
    <div class="citas-card">
        <div class="citas-header">
            <div>
                <h2>Mis citas</h2>
                <p class="citas-subtitle">@Model.NombreEmprendimiento</p>
            </div>

            <div class="citas-badge">
                @Model.TotalItems cita(s)
            </div>
        </div>

        @if (Model.Citas != null && Model.Citas.Any())
        {
            <div class="citas-grid">
                @foreach (var cita in Model.Citas)
                {
                    <div class="cita-item">
                        <div class="cita-top">
                            <div class="cita-servicio">
                                @(cita.Servicio?.Nombre ?? "Servicio")
                            </div>

                            <span class="estado-chip @ObtenerClaseEstado(cita.Estado)">
                                @(string.IsNullOrWhiteSpace(cita.Estado) ? "Sin estado" : cita.Estado)
                            </span>
                        </div>

                        <div class="cita-body">
                            <div class="cita-row">
                                <span class="cita-label">Fecha</span>
                                <span class="cita-value">@cita.Fecha.ToString("dd/MM/yyyy")</span>
                            </div>

                            <div class="cita-row">
                                <span class="cita-label">Día</span>
                                <span class="cita-value">@TraducirDia(cita.Fecha.DayOfWeek)</span>
                            </div>

                            <div class="cita-row">
                                <span class="cita-label">Hora</span>
                                <span class="cita-value">@cita.Fecha.ToString("hh:mm tt")</span>
                            </div>

                            <div class="cita-row">
                                <span class="cita-label">Emprendimiento</span>
                                <span class="cita-value">@Model.NombreEmprendimiento</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="pagination-wrap">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="page-link"
                           asp-controller="Citas"
                           asp-action="MisCitas"
                           asp-route-emprendimientoId="@Model.EmprendimientoId"
                           asp-route-page="@(Model.CurrentPage - 1)">
                            Anterior
                        </a>
                    }
                    else
                    {
                        <span class="page-disabled">Anterior</span>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <a class="page-number @(i == Model.CurrentPage ? "active" : "")"
                           asp-controller="Citas"
                           asp-action="MisCitas"
                           asp-route-emprendimientoId="@Model.EmprendimientoId"
                           asp-route-page="@i">
                            @i
                        </a>
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a class="page-link"
                           asp-controller="Citas"
                           asp-action="MisCitas"
                           asp-route-emprendimientoId="@Model.EmprendimientoId"
                           asp-route-page="@(Model.CurrentPage + 1)">
                            Siguiente
                        </a>
                    }
                    else
                    {
                        <span class="page-disabled">Siguiente</span>
                    }
                </nav>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">📅</div>
                <h3>No tienes citas registradas</h3>
                <p>No se encontraron citas asociadas a este emprendimiento.</p>

                <a class="btn-volver"
                   asp-controller="Cliente"
                   asp-action="InicioCliente">
                    Volver al catálogo
                </a>
            </div>
        }
    </div>
</div>

@functions {
    public string TraducirDia(DayOfWeek dia)
    {
        return dia switch
        {
            DayOfWeek.Monday => "Lunes",
            DayOfWeek.Tuesday => "Martes",
            DayOfWeek.Wednesday => "Miércoles",
            DayOfWeek.Thursday => "Jueves",
            DayOfWeek.Friday => "Viernes",
            DayOfWeek.Saturday => "Sábado",
            DayOfWeek.Sunday => "Domingo",
            _ => dia.ToString()
        };
    }

    public string ObtenerClaseEstado(string? estado)
    {
        if (string.IsNullOrWhiteSpace(estado))
            return "estado-neutral";

        return estado.Trim().ToLower() switch
        {
            "pendiente" => "estado-pendiente",
            "confirmada" => "estado-confirmada",
            "cancelada" => "estado-cancelada",
            "completada" => "estado-completada",
            _ => "estado-neutral"
        };
    }
}