@model IEnumerable<ServiFlow.Models.Emprendimiento>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Inicio cliente";
}

<link rel="stylesheet" href="~/css/IndexGeneral.css" asp-append-version="true" />

<section class="hero">
    <div class="hero-header">
        <div class="hero-text">
            <h1>Portafolio de Servicios</h1>
            <p class="hero-subtitle">
                Elige un emprendimiento, conoce sus servicios y agenda tu próxima cita.
            </p>
        </div>
    </div>
</section>

<section class="grid-servicios">
    @foreach (var e in Model)
    {
        <article class="card-servicio">
            <img class="card-img" src="@e.ImagenUrl" alt="@e.Nombre" />

            <div class="card-overlay"></div>

            <div class="card-content">
                <h3 class="card-title">@e.Nombre</h3>
                <span class="card-sub">@e.TipoServicio</span>
                <p class="card-desc">@e.Descripcion</p>

                <div class="card-buttons">
                    <a class="btn-card btn-reservar"
                       asp-controller="Cliente"
                       asp-action="Detalle"
                       asp-route-id="@e.Id">
                        Ver emprendimiento
                    </a>

                    
                </div>
            </div>
        </article>
    }
</section>

@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

@if (totalPages > 1)
{
    <nav class="pagination-wrap">
        @if (currentPage > 1)
        {
            <a class="page-link"
               asp-controller="Cliente"
               asp-action="InicioCliente"
               asp-route-page="@(currentPage - 1)">
                Anterior
            </a>
        }
        else
        {
            <span class="page-disabled">Anterior</span>
        }

        @for (int i = 1; i <= totalPages; i++)
        {
            <a class="page-number @(i == currentPage ? "active" : "")"
               asp-controller="Cliente"
               asp-action="InicioCliente"
               asp-route-page="@i">
                @i
            </a>
        }

        @if (currentPage < totalPages)
        {
            <a class="page-link"
               asp-controller="Cliente"
               asp-action="InicioCliente"
               asp-route-page="@(currentPage + 1)">
                Siguiente
            </a>
        }
        else
        {
            <span class="page-disabled">Siguiente</span>
        }
    </nav>
}