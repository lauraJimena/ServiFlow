@using Microsoft.AspNetCore.Http

@{
    var usuarioEmail = Context.Session.GetString("UsuarioEmail");
    var usuarioNombre = Context.Session.GetString("UsuarioNombre");

    var sesionActiva = !string.IsNullOrEmpty(usuarioEmail);

    var esHome = ViewContext.RouteData.Values["Controller"]?.ToString() == "Home"
        && ViewContext.RouteData.Values["Action"]?.ToString() == "Index";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ServiFlow</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kanban.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/IndexGeneral.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body class="layout-shell">
    <header class="sf-header">
        <div class="sf-navbar">

            <!-- LOGO -->
            <a class="sf-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo_serviflow.png" alt="Logo ServiFlow" class="sf-logo" />
                ServiFlow
            </a>

            <!-- MENÚ -->
            <nav class="sf-menu">
               

                @if (!sesionActiva)
                {
                    
                    <a class="sf-link" asp-controller="Home" asp-action="Somos">
                        Quienes somos
                    </a>
                    <a class="sf-link" asp-controller="Home" asp-action="Planes">
                        Planes
                    </a>
                    <a class="sf-link" asp-controller="Usuarios" asp-action="Login">
                        Iniciar sesión
                    </a>

                    <a class="sf-link iniciarSesion" asp-controller="Usuarios" asp-action="Registro">
                        Registrarse
                    </a>
                }

            
            <!-- USUARIO LOGUEADO -->
            
                @if (sesionActiva)
                {
                    <span class="sf-layout-user">
                        Hola, @usuarioNombre
                    </span>

                    <a class="sf-layout-profile"
                       asp-controller="Usuarios"
                       asp-action="EditarPerfil">
                        Editar perfil
                    </a>

                    <form asp-controller="Usuarios"
                          asp-action="CerrarSesion"
                          method="post"
                          class="sf-layout-logout-form">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="sf-layout-logout-btn">
                            Cerrar sesión
                        </button>
                    </form>
                }
            </nav>
           
        </div>
    </header>

    @if (esHome)
    {
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="sf-footer">
        <div class="sf-footer-container">

            <!-- Marca -->
            <div class="sf-footer-brand">
                <img src="~/images/logo_serviflow.png" alt="ServiFlow" />
                <h5>ServiFlow</h5>
                <p>Tu talento organizado, tus citas bajo control.</p>
            </div>

            <!-- Enlaces -->
            <div class="sf-footer-links">
                <h6>Enlaces</h6>
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house"></i> Inicio
                </a>

                <a asp-controller="Home" asp-action="Somos">
                    <i class="bi bi-people"></i> Quiénes somos
                </a>

                <a asp-controller="Home" asp-action="Planes">
                    <i class="bi bi-card-checklist"></i> Planes
                </a>
               
            </div>

            <!-- Soporte -->
            <div class="sf-footer-links">
                <h6>Soporte</h6>
                <a href="#">
                    <i class="bi bi-life-preserver"></i> Centro de ayuda
                </a>

                <a href="#">
                    <i class="bi bi-envelope"></i> Contacto
                </a>

                <a href="#">
                    <i class="bi bi-file-text"></i> Términos
                </a>
            </div>

           

        </div>

        <!-- Línea inferior -->
        <div class="sf-footer-bottom">
            <p>&copy; 2026 ServiFlow. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/kanban.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>